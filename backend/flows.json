    {
        "id": "b335f7a53df5ace3",
        "type": "function",
        "z": "bbd6045f1da95b3c",
        "name": "fn feedlogs",
        "func": "/* =========================\n   PARSE PAYLOAD\n========================= */\nlet p = msg.payload;\n\n// Nếu payload là string → parse JSON\nif (typeof p === \"string\") {\n    try {\n        p = JSON.parse(p);\n    } catch (e) {\n        node.error(\"Payload is not valid JSON string\", msg);\n        return null;\n    }\n}\n\nif (!p || typeof p !== \"object\") {\n    node.error(\"Payload is not JSON object\", msg);\n    return null;\n}\n\n/* =========================\n   NORMALIZE STATUS\n========================= */\nlet status;\n\nif (typeof p.status === \"string\") {\n    status = p.status.toUpperCase() === \"ON\" ? 1 : 0;\n} else if (typeof p.status === \"number\") {\n    status = p.status === 1 ? 1 : 0;\n} else {\n    node.error(\"Invalid status type\", msg);\n    return null;\n}\n\n/* Chỉ log khi FEED = ON */\nif (status !== 1) {\n    node.warn(\"Ignore non-feed event\");\n    return null;\n}\n\n/* =========================\n   TIME HANDLING\n========================= */\n// Ưu tiên time từ device, fallback server time\nlet timeISO;\n\nif (p.time) {\n    try {\n        timeISO = new Date(p.time).toISOString();\n    } catch {\n        timeISO = new Date().toISOString();\n    }\n} else {\n    timeISO = new Date().toISOString();\n}\n\n/* =========================\n   NORMALIZED PAYLOAD (BACKEND)\n========================= */\nmsg.payload = {\n    feed: 1,\n    time: timeISO\n};\n\nnode.warn(\"[FEED LOG] \" + JSON.stringify(msg.payload));\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1250,
        "y": 620,
