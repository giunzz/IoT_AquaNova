        "type": "function",
        "z": "bbd6045f1da95b3c",
        "name": "fn light_effect",
        "func": "node.warn(\"[HTTP] IN payload = \" + JSON.stringify(msg.payload));\n\nif (!msg.payload || msg.payload.mode === undefined) {\n    msg.statusCode = 400;\n    msg.payload = { error: \"mode required (0,1,2)\" };\n    return null;\n}\n\nconst mode = Number(msg.payload.mode);\n\nif (![0, 1, 2].includes(mode)) {\n    msg.statusCode = 400;\n    msg.payload = { error: \"mode must be 0,1,2\" };\n    return null;\n}\n\nmsg.topic = \"aquanova/control\";\nmsg.payload = {\n    mode: mode\n};\n\nnode.warn(\"[MQTT] publish mode = \" + mode);\nreturn msg;\n",
