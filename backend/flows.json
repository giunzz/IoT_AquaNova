        "func": "const body = msg.payload || {};\n\nconst light = Number(body.light || 0);\nconst color = body.color;\n\nconst mqttPayload = { light };\n\nif (light === 1 && typeof color === \"string\") {\n    mqttPayload.color = color.toUpperCase();\n}\n\nmsg.topic = \"aquanova/control\";\nmsg.payload = JSON.stringify(mqttPayload);\n\n// debug rất rõ\nnode.warn(\"MQTT PAYLOAD: \" + msg.payload);\n\nreturn msg;\n",
