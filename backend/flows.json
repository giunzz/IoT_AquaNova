    {
        "id": "a373ec347a3b73e5",
        "type": "function",
        "z": "bbd6045f1da95b3c",
        "name": "check_schedule",
        "func": "// ===== INPUT =====\n// msg.payload = { items: [ { id, time, repeat, amount } ] }\n\nconst res = msg.payload || {};\nconst items = res.items || [];\n\n// giờ hiện tại HH:MM\nconst now = new Date();\nconst nowTime = `${String(now.getHours()).padStart(2, \"0\")}:${String(now.getMinutes()).padStart(2, \"0\")}`;\n\nnode.warn(`[CHECK] now=${nowTime}, schedules=${items.length}`);\n\nfor (const s of items) {\n    if (!s.time) continue;\n\n    // normalize HH:MM\n    const parts = String(s.time).split(\":\");\n    const targetTime = `${parts[0].padStart(2, \"0\")}:${parts[1].padStart(2, \"0\")}`;\n\n    if (nowTime !== targetTime) continue;\n\n    node.warn(`[MATCH] schedule=${s.id}, repeat=${s.repeat}`);\n\n    // ---- chống feed lặp trong cùng phút ----\n    const lastFed = flow.get(\"lastFedTime\");\n    if (lastFed === nowTime) return null;\n    flow.set(\"lastFedTime\", nowTime);\n\n    // ===== OUTPUT 1: MQTT FEEDING =====\n    const msgFeed = {\n        payload: JSON.stringify({\n            feeding: 1,\n        })\n    };\n\n    // ===== OUTPUT 2: DELETE INFO (CHỈ KHI once) =====\n    let msgDelete = null;\n\n    if (s.repeat === \"none\") {\n        msgDelete = {\n            schedule_id: s.id\n        };\n        node.warn(`[DELETE PREP] ${s.id}`);\n    }\n\n    return [msgFeed, msgDelete];\n}\n\n// chưa tới giờ\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
